{
  "name": "FitSolver Dev",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "dev",
  "workspaceFolder": "/workspace",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "twxs.cmake"
      ]
    }
  },
  // Keeps the container running after VS Code detaches so it doesn't
  // stop between sessions.
  "shutdownAction": "none"
}
